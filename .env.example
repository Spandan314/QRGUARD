# QRGUARD environment variable index.
# Each app gets its own .env.example in its phase (backend/, web/, mobile/).
# NEVER commit real values. Copy to .env locally; set them in Render / Vercel / EAS for production.

# ---------------------------------------------------------------------------
# BACKEND (server-side SECRETS: never ship to web/mobile)
# ---------------------------------------------------------------------------
# Full, commented list: backend/.env.example
APP_ENV=production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
MAX_JSON_KB=64
RATELIMIT_DEFAULT=60 per minute
RATELIMIT_ANALYZE=20 per minute;200 per day
RATELIMIT_STORAGE_URI=memory://
TRUST_PROXY_HOPS=1
# Risk thresholds and weights are NOT env vars: see backend/app/scoring/scoring_config.yaml

# Added in later phases:
# REDIRECT_RESOLUTION=shorteners_only     (Phase 2 URL analysis)
# HISTORY_RETENTION_DAYS=90               (Phase 7 Firebase)

# Firebase Admin: path to the service-account JSON (Render Secret File)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Threat intelligence (all optional; a provider is disabled if its key is empty)
TI_LOCAL_FEEDS_ENABLED=true
URLHAUS_AUTH_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
PHISHTANK_API_KEY=

# ---------------------------------------------------------------------------
# WEB (PUBLIC client config: bundled into the browser, not secret)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# MOBILE (PUBLIC client config: bundled into the app, not secret)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
