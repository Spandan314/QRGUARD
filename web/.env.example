# QRGUARD web app. Copy to .env.local for local development. Never put secrets here:
# every VITE_ variable is compiled into the public JavaScript bundle.

# Backend base URL (no trailing slash). Local Flask dev server by default.
VITE_API_BASE_URL=http://localhost:5000

# Sign-in: firebase | dev | off. Default: firebase when VITE_FIREBASE_API_KEY is set, else off.
#   dev = demo accounts without a Firebase project (backend must run with AUTH_DEV_TOKENS=true;
#         the backend refuses that in production).
# VITE_AUTH_MODE=dev

# Firebase web-app config (Firebase console -> Project settings -> Your apps -> Web app).
# These values are PUBLIC identifiers, not secrets; access is protected by the backend verifying
# ID tokens and by Firestore rules. NEVER put a service-account key here.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=qrguard-demo.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=qrguard-demo
# VITE_FIREBASE_APP_ID=
# Local Firebase Auth emulator (optional): 127.0.0.1:9099
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
