# QRGUARD mobile app. Copy to .env for local development. Every EXPO_PUBLIC_* value is compiled
# into the app and is PUBLIC: never put secrets here.
# The phone must reach the backend: use your computer's LAN IP, not localhost, on a real device
# (Android emulator: http://10.0.2.2:5000).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5000

# Sign-in: firebase | dev | off. Default: firebase when EXPO_PUBLIC_FIREBASE_API_KEY is set, else off.
#   dev = demo accounts without a Firebase project (backend: AUTH_DEV_TOKENS=true, never production).
# EXPO_PUBLIC_AUTH_MODE=dev

# Firebase app config (Firebase console -> Project settings -> Your apps). PUBLIC identifiers, not
# secrets; access is protected by the backend verifying ID tokens. NEVER put a service-account key here.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=qrguard-demo.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=qrguard-demo
# EXPO_PUBLIC_FIREBASE_APP_ID=
# Local Firebase Auth emulator (Android emulator: 10.0.2.2:9099)
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=10.0.2.2:9099

# EAS builds (docs/deployment.md §4): these are set with `eas env:create`, not in this file.
#   EAS_PROJECT_ID            printed by `eas init` (app.config.ts is dynamic, so it is read from here)
#   EXPO_PUBLIC_API_BASE_URL  must be the https:// backend URL; preview/production builds refuse anything else
