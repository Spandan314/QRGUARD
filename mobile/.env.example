# QRGUARD mobile app. Copy to .env for local development. Every EXPO_PUBLIC_* value is compiled
# into the app and is PUBLIC: never put secrets here.
# The phone must reach the backend: use your computer's LAN IP, not localhost, on a real device
# (Android emulator: http://10.0.2.2:5000).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5000
