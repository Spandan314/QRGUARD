{
  "info": {
    "name": "QRGUARD API",
    "description": "QRGUARD backend API. /api/analyze/url is implemented; other analysis endpoints validate input and return 501 until their modules are built.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has X-Request-ID', () => pm.response.to.have.header('X-Request-ID'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "URL analysis (DEMO / TEST DATA)",
      "description": "No request here makes the backend contact any website: none of these URLs is a link shortener, so redirects are not followed.",
      "item": [
        {
          "name": "SAFE + VERIFIED: trusted HTTPS site",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://en.wikipedia.org/wiki/QR_code\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/analyze/url",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "analyze",
                "url"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('risk level is SAFE', () => pm.expect(pm.response.json().risk_level).to.eql('SAFE'));",
                  "pm.test('every indicator is explained', () => pm.response.json().indicators.forEach(i => { pm.expect(i.message).to.be.a('string'); pm.expect(i).to.have.property('score_contribution'); }));",
                  "pm.test('has indicator TRUSTED_DOMAIN', () => pm.expect(pm.response.json().indicators.map(x => x.id)).to.include('TRUSTED_DOMAIN'));",
                  "pm.test('verified by trusted list', () => pm.expect(pm.response.json().verification.source).to.eql('trusted_domain_list'));"
                ]
              }
            }
          ]
        },
