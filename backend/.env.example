# QRGUARD backend environment variables.
# Copy to backend/.env for local development:   cp .env.example .env
# In production (Render) set these in the dashboard. Never commit a real .env file.
# Every variable is optional: the defaults shown are used if it is missing.

# development | production | testing   (development enables Flask debug mode)
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API (the web app).
# Mobile apps are not affected by CORS. "*" is refused when APP_ENV=production.
ALLOWED_ORIGINS=http://localhost:5173

# Request size limits
MAX_UPLOAD_MB=5
MAX_JSON_KB=64

# Rate limits (Flask-Limiter syntax, several limits separated by ";")
RATELIMIT_DEFAULT=60 per minute
RATELIMIT_ANALYZE=20 per minute;200 per day
# memory:// is per-process. Use a redis:// URI later if you need shared limits.
RATELIMIT_STORAGE_URI=memory://

# Number of reverse proxies in front of the app (0 locally, 1 on Render),
# so the real client IP is used for rate limiting.
TRUST_PROXY_HOPS=0

# Redirect checking (URL analysis). The backend only contacts a link to see where it
# redirects; it never downloads page content. See docs/security.md.
#   off              never contact links
#   shorteners_only  only follow known link shorteners (default, recommended)
#   all              follow every http(s) link
REDIRECT_RESOLUTION=shorteners_only
REDIRECT_MAX_HOPS=5
REDIRECT_TIMEOUT_SECONDS=3
REDIRECT_TOTAL_TIMEOUT_SECONDS=8

# Screenshot analysis (OCR). Tesseract must be installed: apt install tesseract-ocr
# (Windows: UB-Mannheim installer, macOS: brew install tesseract). The Docker image includes it.
RATELIMIT_SCREENSHOT=6 per minute;60 per day
MAX_IMAGE_MEGAPIXELS=25
# TESSERACT_CMD=tesseract          # full path if tesseract is not on PATH (e.g. on Windows)
OCR_LANGUAGES=eng
OCR_TIMEOUT_SECONDS=20
OCR_MAX_CONCURRENT=2

# Threat intelligence (docs/threat-intelligence.md). Local feeds work offline and are on by default.
# External providers are enabled only when their key is set. NEVER commit real keys.
THREAT_INTEL_LOCAL_FEEDS_ENABLED=true
# Folder with downloaded feeds (fill it with: flask --app wsgi ti-update-feeds)
# THREAT_INTEL_FEED_DIR=instance/feeds
THREAT_INTEL_TIMEOUT_SECONDS=3
THREAT_INTEL_BUDGET_SECONDS=6
THREAT_INTEL_CACHE_LISTED_SECONDS=86400
THREAT_INTEL_CACHE_NOT_LISTED_SECONDS=3600
# URLHAUS_AUTH_KEY=
# GOOGLE_SAFE_BROWSING_API_KEY=
# VIRUSTOTAL_API_KEY=            # lookup only, never submits URLs
# PHISHTANK_API_KEY=             # optional; new registrations are closed

# Optional: path to an alternative scoring configuration file.
# Default: app/scoring/scoring_config.yaml
# SCORING_CONFIG_PATH=

# Used by gunicorn in production (Render sets PORT automatically).
# PORT=5000
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=4
